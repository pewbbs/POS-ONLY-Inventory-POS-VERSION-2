APP_NAME=POSONLY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
APP_TIMEZONE=Asia/Manila
BILLING_SIMULATIONS_ENABLED=true
# Use paymongo with test credentials for local hosted invoice checkout.
BILLING_PAYMENT_PROVIDER=simulation
PAYMONGO_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_PAYMENT_METHODS=card,gcash
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
COMMERCE_SIMULATIONS_ENABLED=true
# Comma-separated IP addresses or CIDRs of your actual reverse proxies.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_WORKER_TIMEOUT=60

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DEMO_ENABLED=false

# Company sign-in. Leave credentials empty until provider setup is complete.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Absolute path to a private Apple .p8 key file outside public and storage/app/public.
APPLE_PRIVATE_KEY_PATH=
# Apple requires a registered public HTTPS callback; loopback is unsupported.
APPLE_REDIRECT_URI=
