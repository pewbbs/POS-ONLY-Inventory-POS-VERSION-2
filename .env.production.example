APP_NAME=POSONLY
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DEMO_ENABLED=false
BILLING_SIMULATIONS_ENABLED=false
BILLING_PAYMENT_PROVIDER=simulation
# This release's PayMongo invoice checkout supports local test mode only.
PAYMONGO_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
COMMERCE_SIMULATIONS_ENABLED=false
# Actual reverse-proxy IPs/CIDRs only; leave empty when no proxy is used.
TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=stockroom
DB_USERNAME=stockroom_app
DB_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_WORKER_TIMEOUT=60
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local

# Configure an actual mail provider before enabling recovery for customers.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=465
MAIL_USERNAME=replace-with-your-mail-username
MAIL_PASSWORD=replace-with-your-mail-password
MAIL_FROM_ADDRESS=support@your-domain.example
MAIL_FROM_NAME=POSONLY

# Web binds to loopback; put your HTTPS reverse proxy in front of this port.
STOCKROOM_HTTP_PORT=8081

# Optional company sign-in. Use the exact provider-registered HTTPS callbacks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Absolute path to a private Apple .p8 key file outside public and storage/app/public.
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=
